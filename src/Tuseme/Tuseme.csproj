<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0;net8.0</TargetFrameworks>
    <RootNamespace>Tuseme</RootNamespace>
    <AssemblyName>Tuseme</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Tuseme</Authors>
    <Description>Official .NET SDK for the Tuseme SMS API</Description>
    <PackageId>Tuseme</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://docs.tuseme.co.ke/sdks</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tuseme/tuseme-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>sms;tuseme;api;messaging;kenya;africa;bulk-sms</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
